# Environment Variables for OAuth2 Integration
# Copy this file to .env.local and fill in your actual values

# Lucidchart OAuth2 Configuration
# Get these from: https://developer.lucidchart.com/
VITE_LUCIDCHART_CLIENT_ID=your_lucidchart_client_id_here
VITE_LUCIDCHART_CLIENT_SECRET=your_lucidchart_client_secret_here

# Microsoft Graph OAuth2 Configuration  
# Get these from: https://portal.azure.com/ → App registrations
VITE_MICROSOFT_CLIENT_ID=your_microsoft_client_id_here

# Draw.io OAuth2 Configuration (Google Drive API for file storage)
# Get these from: https://console.cloud.google.com/ → APIs & Services → Credentials
VITE_DRAWIO_CLIENT_ID=your_google_client_id_here

# Optional: Custom redirect URIs (defaults to current domain)
# For localhost development, these should be:
# - http://localhost:5173/oauth/callback/lucidchart
# - http://localhost:5173/oauth/callback/microsoft  
# - http://localhost:5173/oauth/callback/drawio
# VITE_OAUTH_REDIRECT_BASE_URL=https://your-domain.com

# Development Mode (set to 'true' to enable mock authentication for testing)
VITE_DEV_MODE=false
